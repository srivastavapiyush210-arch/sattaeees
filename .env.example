# ====================================================================
# Sattaees Environment Variables Example Configuration (.env.example)
# Copy this file to .env and configure secrets before production deploy.
# ====================================================================

# Active Spring Profile (local, test, prod)
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL Configuration
POSTGRES_DB=sattaees
POSTGRES_USER=sattaees_user
POSTGRES_PASSWORD=sattaees_secure_password_replace_me
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/sattaees
SPRING_DATASOURCE_USERNAME=sattaees_user
SPRING_DATASOURCE_PASSWORD=sattaees_secure_password_replace_me

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# JWT Security Secrets (Must be at least 256 bits long base64/hex for HS256)
JWT_SECRET=dGhpc2lzYXN1cGVyc2VjcmV0a2V5dGhhdG5lZWRzdG9iZWF0bGVhc3QyNTZiaXRzbG9uZ2ZvcmhtYWNzaGEyNTYxMjM0NQ==
# Access token TTL: 86400000 ms (24 hours)
JWT_ACCESS_EXPIRATION=86400000
# Refresh token TTL: 604800000 ms (7 days)
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174
